# ScalperBot Configuration
# Copy this file to .env and fill in your values

# === Mode ===
DRY_RUN=true
DEBUG=false

# === MEXC API ===
# Get from: https://www.mexc.com/user/openapi
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here

# === Telegram ===
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# === Trading Parameters ===
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT
POSITION_SIZE_USDT=50.0
MAX_OPEN_POSITIONS=3

# === Polling ===
POLL_INTERVAL_SEC=10
KLINE_LIMIT=30

# === Entry Triggers ===
BUY_PCT_TRIGGER=0.5
BUY_SCORE_MIN=2.0

# === Exit Triggers ===
SELL_PCT_TRIGGER=-0.3
SELL_SCORE_MAX=-1.0

# === Risk Management ===
BASE_SL_PCT=2.0
TAKE_PROFIT_PCT=3.0
TRAILING_ENABLED=true
TRAILING_START_PCT=1.5
TRAILING_OFFSET_PCT=0.5

# === Safety Filters ===
MAX_SPREAD_PCT=0.5
MIN_24H_VOLUME_USDT=100000
COOLDOWN_SEC=300

# === Order Execution ===
USE_LIMIT_ORDERS=true
LIMIT_ORDER_TIMEOUT_SEC=30

# === Database ===
DATABASE_PATH=scalperbot.db

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=scalperbot.log

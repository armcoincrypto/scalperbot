# ScalperBot Configuration

# MEXC API Credentials
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_secret_here

# Trading Mode
DRY_RUN=true  # Set to false for live trading

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT

# Strategy Intervals (seconds)
STRATEGY_INTERVAL=60  # Run strategy every 60 seconds
DATA_POLL_INTERVAL=10  # Poll market data every 10 seconds

# GREEN Filter Parameters
GREEN2_BB_PERIOD=20
GREEN2_BB_STD=2.0
GREEN3_VOLUME_THRESHOLD=1.5
GREEN3_ENABLED=false  # Disable volume filter for testing
GREEN4_BREAKOUT_PERIOD=10
GREEN4_BREAKOUT_BUFFER_BPS=10

# Position Sizing
POSITION_SIZE_USD=100.0
MAX_POSITIONS=3

# Risk Management
DAILY_LOSS_LIMIT_PCT=3.0  # Stop trading if down 3% for the day

# Database
DATABASE_PATH=scalperbot/trades.db

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram Status Reports
STATUS_ENABLED=true  # Enable hourly status reports
STATUS_INTERVAL_MIN=60  # Send status every N minutes
EARLY_WARN_PCT=0.1  # Alert when price within X% of breakout (0.1 = 0.1%)
EARLY_WARN_COOLDOWN_MIN=60  # One early warning per symbol per N minutes

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Analysis Service (tools/analyzer.py)
ANALYSIS_ENABLED=true
ANALYSIS_RETENTION_DAYS=30  # Keep analysis reports for N days
ANALYSIS_MIN_TRADES=20  # Minimum trades per symbol for recommendations
ANALYSIS_OUTPUT_DIR=analysis
AGGRESSIVE_NEARMISS_PCT=15  # Near-miss rate threshold for aggressive recommendation
AGGRESSIVE_MIN_WINRATE=55  # Minimum win rate for aggressive recommendation
AGGRESSIVE_MIN_PF=1.15  # Minimum profit factor for aggressive recommendation

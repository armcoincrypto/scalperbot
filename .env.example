# ScalperBot Configuration

# MEXC API Credentials
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_secret_here

# Trading Mode
DRY_RUN=true  # Set to false for live trading

# Trading Pairs (JSON array format - required!)
TRADING_PAIRS=["BTC/USDT", "ETH/USDT", "SOL/USDT", "XRP/USDT"]

# Strategy Intervals (seconds)
STRATEGY_INTERVAL=60  # Run strategy every 60 seconds
DATA_POLL_INTERVAL=10  # Poll market data every 10 seconds

# GREEN Filter Parameters
GREEN2_BB_PERIOD=20
GREEN2_BB_STD=2.0
GREEN2_LOOKBACK_HOURS=48  # Hours of BB width history for percentile calc
GREEN3_VOLUME_THRESHOLD=1.5
GREEN3_ENABLED=false  # Disable volume filter for testing
GREEN4_BREAKOUT_PERIOD=10
GREEN4_BREAKOUT_BUFFER_BPS=10

# Dynamic Squeeze Policy Parameters
SQUEEZE_NO_SIGNAL_TIMEOUT_MINUTES=30  # Relax after N minutes without signals
SQUEEZE_PERMISSIVE_DURATION_MINUTES=15  # Stay permissive for M minutes
SQUEEZE_DRY_RUN_LOSS_BREAKER_PCT=2.0  # Auto-revert if losses exceed this %
SQUEEZE_ENABLE_MONITORING=true  # Enable dry-run monitoring

# Relaxed Session (Controlled Experiment) - Time-boxed filter relaxation
SQUEEZE_ENABLE_RELAXED_SESSION=false  # Enable temporary relaxed thresholds
SQUEEZE_RELAXED_SESSION_HOURS=48  # Auto-revert after N hours

# Position Sizing
POSITION_SIZE_USD=100.0
MAX_POSITIONS=3

# Risk Management
DAILY_LOSS_LIMIT_PCT=3.0  # Stop trading if down 3% for the day

# Database
DATABASE_PATH=scalperbot/trades.db

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

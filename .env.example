# ScalperBot v2.0 Configuration

# MEXC API Credentials
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_secret_here

# Trading Mode
DRY_RUN=true  # Set to false for live trading

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT

# Strategy Intervals (seconds)
STRATEGY_INTERVAL=60  # Run strategy every 60 seconds
DATA_POLL_INTERVAL=10  # Poll market data every 10 seconds

# GREEN Filter Parameters
GREEN2_BB_PERIOD=20
GREEN2_BB_STD=2.0
GREEN3_VOLUME_THRESHOLD=1.2  # Volume Z-score threshold (lowered from 1.5)
GREEN3_ENABLED=true  # ENABLED - important for signal quality
GREEN4_BREAKOUT_PERIOD=10
GREEN4_BREAKOUT_BUFFER_BPS=10

# Position Sizing
POSITION_SIZE_USD=100.0
MAX_POSITIONS=3

# Per-Symbol Minimum Notional (JSON format)
# To avoid MIN_NOTIONAL errors on exchanges
PER_SYMBOL_MIN_NOTIONAL={"BTC/USDT": 200, "ETH/USDT": 100, "SOL/USDT": 25, "XRP/USDT": 25, "LTC/USDT": 25}

# Take Profit / Stop Loss Settings
TAKE_PROFIT_PCT=2.0  # Take profit at 2% gain (requires ~33% win rate to break even)
STOP_LOSS_PCT=1.0    # Stop loss at 1% loss

# Trailing Stop Settings
TRAILING_ENABLED=true      # Enable trailing stop
TRAIL_START_PCT=0.5        # Start trailing when +0.5% profit reached
TRAIL_OFFSET_PCT=0.15      # Trail offset from peak (break-even + cushion)

# Time-based Exit
MAX_HOLD_HOURS=6.0  # Close position after N hours (prevents holding too long)

# Pullback Entry (better entries - avoid buying at the top)
PULLBACK_ENTRY_ENABLED=true   # Wait for small retracement before entering
PULLBACK_ENTRY_PCT=0.3        # Require 0.3% pullback from breakout
PULLBACK_MAX_CANDLES=3        # Max candles to wait for pullback

# Risk Management
DAILY_LOSS_LIMIT_PCT=3.0  # Stop trading if down 3% for the day

# Position Monitoring
POSITION_CHECK_INTERVAL=10  # Check positions every N seconds

# Database
DATABASE_PATH=scalperbot/trades.db

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

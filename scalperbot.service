[Unit]
Description=ScalperBot - Cryptocurrency Trading Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/scalperbot
Environment="PATH=/home/user/scalperbot/.venv/bin"
ExecStart=/home/user/scalperbot/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/user/scalperbot/bot.log
StandardError=append:/home/user/scalperbot/bot.log

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

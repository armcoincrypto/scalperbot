[Unit]
Description=ScalperBot - Cryptocurrency Trading Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/scalperbot
Environment="PATH=/root/scalperbot/.venv/bin"
ExecStart=/root/scalperbot/.venv/bin/python -m scalperbot.main
Restart=always
RestartSec=10
StandardOutput=append:/root/scalperbot/bot.log
StandardError=append:/root/scalperbot/bot.log

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
